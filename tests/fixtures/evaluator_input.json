{
  "flags": [
    {
      "key": "dynamic_checkout_flow",
      "enabled": true,
      "rules": [
        {
          "conditions": [
            { "field": "country", "op": "InSet", "value": ["US", "CA", "GB"] },
            { "field": "app_version", "op": "SemverGte", "value": "3.0.0" },
            { "field": "subscription_tier", "op": "Equals", "value": "enterprise" }
          ],
          "rollout_percentage": 100,
          "variant": "one_click_enterprise"
        },
        {
          "conditions": [
            { "field": "segment_ids", "op": "Contains", "value": "beta_testers" },
            { "field": "cart_value", "op": "GreaterThan", "value": 100.0 }
          ],
          "rollout_percentage": 50,
          "variant": "beta_discount_checkout"
        }
      ],
      "default_variant": "standard_checkout"
    },
    {
      "key": "emergency_killed_feature",
      "enabled": false,
      "rules": [],
      "default_variant": "dormant"
    }
  ],
  "evaluation_requests": [
